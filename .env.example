# Local development reads Worker secrets from .dev.vars (never commit that file).
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
KEY_ENCRYPTION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Optional CoinGecko demo key, for fallback market prices.
COINGECKO_API_KEY=
